!- Linux Line endings 

VERSION,
    25.1.0;                   !- Version Identifier

SIMULATIONCONTROL,
    No,                       !- Do Zone Sizing Calculation
    No,                       !- Do System Sizing Calculation
    No,                       !- Do Plant Sizing Calculation
    Yes,                      !- Run Simulation for Sizing Periods
    Yes,                      !- Run Simulation for Weather File Run Periods
    Yes,                      !- Do HVAC Sizing Simulation for Sizing Periods
    1;                        !- Maximum Number of HVAC Sizing Simulation Passes

BUILDING,
    sm20_anchor,              !- Name
    0,                        !- North Axis
    Suburbs,                  !- Terrain
    0.04,                     !- Loads Convergence Tolerance Value
    0.4,                      !- Temperature Convergence Tolerance Value
    FullExterior,             !- Solar Distribution
    25,                       !- Maximum Number of Warmup Days
    1;                        !- Minimum Number of Warmup Days

SITE:LOCATION,
    Shenzhen,                 !- Name
    22.54,                    !- Latitude
    114.06,                   !- Longitude
    8,                        !- Time Zone
    0;                        !- Elevation

RUNPERIOD,
    Default Run Period,       !- Name
    1,                        !- Begin Month
    1,                        !- Begin Day of Month
    ,                         !- Begin Year
    12,                       !- End Month
    31,                       !- End Day of Month
    ,                         !- End Year
    ,                         !- Day of Week for Start Day
    Yes,                      !- Use Weather File Holidays and Special Days
    Yes,                      !- Use Weather File Daylight Saving Period
    No,                       !- Apply Weekend Holiday Rule
    Yes,                      !- Use Weather File Rain Indicators
    Yes,                      !- Use Weather File Snow Indicators
    No,                       !- Treat Weather as Actual
    Hour24;                   !- First Hour Interpolation Starting Values

SCHEDULETYPELIMITS,
    Temperature,              !- Name
    0,                        !- Lower Limit Value
    100,                      !- Upper Limit Value
    CONTINUOUS,               !- Numeric Type
    Temperature;              !- Unit Type

SCHEDULETYPELIMITS,
    Fraction,                 !- Name
    0,                        !- Lower Limit Value
    1,                        !- Upper Limit Value
    CONTINUOUS,               !- Numeric Type
    Dimensionless;            !- Unit Type

SCHEDULETYPELIMITS,
    AnyNumber,                !- Name
    ,                         !- Lower Limit Value
    ,                         !- Upper Limit Value
    CONTINUOUS,               !- Numeric Type
    Dimensionless;            !- Unit Type

SCHEDULE:COMPACT,
    Office_Heating_Setpoint,    !- Name
    Temperature,              !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00, 20.0;       !- Field 3

SCHEDULE:COMPACT,
    Office_Cooling_Setpoint,    !- Name
    Temperature,              !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00, 24.0;       !- Field 3

SCHEDULE:COMPACT,
    Office_Avail_Schedule,    !- Name
    Fraction,                 !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00, 1.0;        !- Field 3

SCHEDULE:COMPACT,
    Office_Occupancy_Schedule,    !- Name
    Fraction,                 !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: Weekdays,            !- Field 2
    Until: 09:00, 0.0,        !- Field 3
    Until: 18:00, 1.0,        !- Field 4
    Until: 24:00, 0.0,        !- Field 5
    For: Weekends,            !- Field 6
    Until: 24:00, 0.0,        !- Field 7
    For: Holidays,            !- Field 8
    Until: 24:00, 0.0,        !- Field 9
    For: AllOtherDays,        !- Field 10
    Until: 24:00, 0.0;        !- Field 11

SCHEDULE:COMPACT,
    Office_Activity_Schedule,    !- Name
    AnyNumber,                !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00, 120.0;      !- Field 3

SCHEDULE:COMPACT,
    Office_Lighting_Schedule,    !- Name
    Fraction,                 !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: Weekdays,            !- Field 2
    Until: 09:00, 0.0,        !- Field 3
    Until: 18:00, 1.0,        !- Field 4
    Until: 24:00, 0.0,        !- Field 5
    For: Weekends,            !- Field 6
    Until: 24:00, 0.0,        !- Field 7
    For: Holidays,            !- Field 8
    Until: 24:00, 0.0,        !- Field 9
    For: AllOtherDays,        !- Field 10
    Until: 24:00, 0.0;        !- Field 11

SCHEDULE:COMPACT,
    Office_Control_Type_Schedule,    !- Name
    AnyNumber,                !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00, 4.0;        !- Field 3

MATERIAL,
    Mat_Stucco,               !- Name
    MediumRough,              !- Roughness
    0.025,                    !- Thickness
    0.72,                     !- Conductivity
    1856,                     !- Density
    840,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Mat_Insulation,           !- Name
    MediumRough,              !- Roughness
    0.05,                     !- Thickness
    0.04,                     !- Conductivity
    32,                       !- Density
    1210,                     !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Mat_Gypsum,               !- Name
    Smooth,                   !- Roughness
    0.0125,                   !- Thickness
    0.16,                     !- Conductivity
    800,                      !- Density
    1090,                     !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Mat_Floor_Concrete,       !- Name
    MediumRough,              !- Roughness
    0.15,                     !- Thickness
    1.13,                     !- Conductivity
    2100,                     !- Density
    1000,                     !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Mat_Roof_Membrane,        !- Name
    VerySmooth,               !- Roughness
    0.01,                     !- Thickness
    0.16,                     !- Conductivity
    1120,                     !- Density
    1460,                     !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

WINDOWMATERIAL:SIMPLEGLAZINGSYSTEM,
    Mat_SingleGlazing,        !- Name
    3,                        !- UFactor
    0.5,                      !- Solar Heat Gain Coefficient
    ;                         !- Visible Transmittance

CONSTRUCTION,
    Default_Ext_Wall,         !- Name
    Mat_Stucco,               !- Outside Layer
    Mat_Insulation,           !- Layer 2
    Mat_Gypsum;               !- Layer 3

CONSTRUCTION,
    Default_Int_Wall,         !- Name
    Mat_Gypsum,               !- Outside Layer
    Mat_Insulation,           !- Layer 2
    Mat_Gypsum;               !- Layer 3

CONSTRUCTION,
    Default_GroundFloor,      !- Name
    Mat_Floor_Concrete,       !- Outside Layer
    Mat_Insulation,           !- Layer 2
    Mat_Gypsum;               !- Layer 3

CONSTRUCTION,
    Cons_InterFloor,          !- Name
    Mat_Floor_Concrete;       !- Outside Layer

CONSTRUCTION,
    Default_Roof,             !- Name
    Mat_Roof_Membrane,        !- Outside Layer
    Mat_Insulation,           !- Layer 2
    Mat_Gypsum;               !- Layer 3

CONSTRUCTION,
    Default_Window,           !- Name
    Mat_SingleGlazing;        !- Outside Layer

GLOBALGEOMETRYRULES,
    UpperLeftCorner,          !- Starting Vertex Position
    Counterclockwise,         !- Vertex Entry Direction
    World,                    !- Coordinate System
    Relative,                 !- Daylighting Reference Point Coordinate System
    Relative;                 !- Rectangular Surface Coordinate System

