{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/opt/venv/bin/python /tmp/ep_accept_S1/guard.py",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(//tmp/ep_accept_S1/**)",
      "Write(//tmp/ep_accept_S1/out/**)",
      "Edit(//tmp/ep_accept_S1/out/**)",
      "Write(//tmp/ep_accept_S1/requests/**)",
      "Edit(//tmp/ep_accept_S1/requests/**)",
      "Bash"
    ],
    "defaultMode": "default",
    "deny": [
      "Read(//workspaces/EnergyPlus-Agent-dev/**)",
      "Read(//root/**)",
      "Read(//home/**)",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "mcp__*"
    ]
  }
}