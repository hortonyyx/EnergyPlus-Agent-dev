# --- Required for downstream pipeline (9 subagents + simulate) ---
# DeepSeek V4 pro, OpenAI-compatible API. Resolved by llm.yaml `default` section.
# Model ids in service (GA): deepseek-v4-pro / deepseek-v4-flash. The `-preview`
# ids are retired; `deepseek-chat`/`deepseek-reasoner` silently map to v4-flash.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Anthropic-protocol endpoint for the DeepSeek dev seat (scripts/deepseek_code.sh).
# Optional — the launcher defaults to this exact value.
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# --- Optional: only set if you have direct Anthropic API access ---
# Used by llm.yaml `intake` section. Most users drive intake via a half-manual
# Claude Code session (see AI_agent/guides/new_case_guide.md) and leave these blank.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# --- GLM (Zhipu BigModel) dev seat: scripts/glm_code.sh ---
# NEVER export these as ANTHROPIC_* globally — that hijacks the primary Claude
# Code session. The launcher injects them into its own subshell only.
#   GLM_ANTHROPIC_BASE_URL -> Claude Code / Anthropic-protocol clients (subscription quota)
#   GLM_BASE_URL           -> OpenAI-protocol clients (llm.yaml sections)
GLM_API_KEY=
GLM_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# --- Other ---
QDRANT_ENDPOINT=
QDRANT_API_KEY=
GEMINI_API_KEY=

# Optional override for the EnergyPlus executable. If unset, src/runner/runner.py
# resolves in order: $ENERGYPLUS_EXE → `energyplus` on PATH →
# DEFAULT_ENERGYPLUS_EXE in runner.py (currently D:\EnergyPlusV25-2-0\energyplus.exe).
ENERGYPLUS_EXE=

# Legacy single-LLM env vars (kept for compatibility with old flat llm.yaml).
# New code reads DEEPSEEK_* / ANTHROPIC_* above.
LLM_API_KEY=
LLM_BASE_URL=

# Optional LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=
