+# =========================================================================== #
+# Rework-3 (2026-09-01) -- absent declared, payload riding along
+# (dispatch: ../request/2026-09-01_o22m2_absent_with_payload_dispatch.md.
+#  The rework-2 gates both opened with `if state != "present": continue`,
+#  so the declaration itself was the swapped carrier: flipping it to absent
+#  -- or dropping the row outright -- made every payload gate look away.)
+# =========================================================================== #
+def _declare_channel_absent(
+    art: CorrectionEvidenceBundleArtifactV1, channel: str,
+) -> CorrectionEvidenceBundleArtifactV1:
+    """The dispatch's §一 mutation: flip ONE channel row to ``absent`` with
+    a ``missing_channel`` debt, leave the payload exactly where it was.
+    Everything else (refs, hashes, other rows) stays coherent, so any red
+    can only come from the declaration-vs-payload disagreement."""
+    art = art.model_copy(deep=True)
+    debt_id = f"debt_{channel}_absent_probe"
+    art.bundle.evidence_debts.append(EvidenceDebtV1(
+        debt_id=debt_id, kind="missing_channel", channel=channel,
+        description="channel declared absent for the rework-3 probe",
+    ))
+    art.bundle.channel_status = [
+        (
+            s.model_copy(update={
+                "state": "absent",
+                "source_input_ids": (),
+                "covered_by_debt_ids": (debt_id,),
+            })
+            if s.channel == channel
+            else s
+        )
+        for s in art.bundle.channel_status
+    ]
+    return _refinalize(art)
+
+
+def test_absent_declaration_with_payload_is_loud(monkeypatch):
+    """Rework-3, the dispatch's §一① / §一②.  BEFORE (payload gate
+    neutered): declaring walls -- or plan_openings -- absent while its
+    claims/dispositions/openings ride along in the bundle VALIDATES on this
+    tree (the orchestrator reproduced it independently; this re-runs that
+    reproduction as the green premise).  AFTER: loud, with the channel and
+    the payload member count named."""
+    for channel, members in (("walls", 6), ("plan_openings", 1)):
+        art = _declare_channel_absent(_tiny_artifact(), channel)
+        assert len(art.bundle.wall_claims) == 2
+        assert len(art.bundle.face_dispositions) == 4
+        assert len(art.bundle.opening_claims) == 1  # payload untouched
+        # BEFORE: neuter the payload gate and the tree-of-record waves the
+        # shape through -- the red can only come from the gate under test
+        monkeypatch.setattr(
+            evidence_contract, "_assert_channel_payload_closure", lambda b: None
+        )
+        validate_evidence_bundle(art.model_copy(deep=True))
+        monkeypatch.undo()
+
+        # AFTER: loud
+        err = _expect_error(
+            art.model_copy(deep=True), "ABSENT_CHANNEL_WITH_PAYLOAD"
+        )
+        assert err.context == {"channel": channel, "payload_members": members}
+
+    # the other direction: the honest fixtures with genuinely absent,
+    # genuinely empty channels stay green (tiny's three absent channels,
+    # the legacy fixture's four, the empty product's four)
+    validate_evidence_bundle(_tiny_artifact())
+    validate_evidence_bundle(_legacy_artifact())
+    validate_evidence_bundle(_empty_artifact_with_zero_payload_debt())
+
+
+def _empty_artifact_with_zero_payload_debt(
+) -> CorrectionEvidenceBundleArtifactV1:
+    """Acceptance #3's legal exit, spelled out: a walls=present row on a
+    genuine whole-channel zero run plus its explicit ``zero_payload_channel``
+    debt -- the shape F-1 kept alive on purpose."""
+    honest = _empty_artifact()
+    honest.bundle.evidence_debts.append(_zero_payload_debt(
+        "debt_zero_walls", "walls"
+    ))
+    return _refinalize(honest)
+
+
+def test_payload_with_no_status_row_is_loud(monkeypatch):
+    """Rework-3, the third same-shape input the dispatch asked for (⛔ not
+    §一's two): the declaration is not false but GONE -- the walls row is
+    dropped entirely while its payload rides along.  BEFORE (payload gate
+    neutered): validates (B-1 iterates rows, so a channel with no row is
+    never asked where its payload came from either).  AFTER: loud -- a
+    missing row must not be a quieter way to say absent."""
+    art = _tiny_artifact().model_copy(deep=True)
+    art.bundle.channel_status = [
+        s for s in art.bundle.channel_status if s.channel != "walls"
+    ]
+    art = _refinalize(art)
+    assert len(art.bundle.wall_claims) == 2  # payload still in the bundle
+
+    # BEFORE
+    monkeypatch.setattr(
+        evidence_contract, "_assert_channel_payload_closure", lambda b: None
+    )
+    validate_evidence_bundle(art.model_copy(deep=True))
+    monkeypatch.undo()
+
+    # AFTER
+    err = _expect_error(
+        art.model_copy(deep=True), "CHANNEL_PAYLOAD_WITHOUT_STATUS_ROW"
+    )
+    assert err.context == {"channel": "walls", "payload_members": 6}
+
+    # boundary this gate deliberately does NOT draw: an EMPTY channel with
+    # no row at all makes no false claim, so it stays green (a "every
+    # channel must have a row" completeness rule is nowhere in the contract)
+    rowless = _empty_artifact().model_copy(deep=True)
+    rowless.bundle.channel_status = [
+        s for s in rowless.bundle.channel_status if s.channel != "walls"
+    ]
+    validate_evidence_bundle(_refinalize(rowless))
+
+
