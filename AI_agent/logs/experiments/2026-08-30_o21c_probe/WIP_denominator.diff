+def denominator_from_facts(view, request: "TarchConversionRequestV1", *,
+                           merge_m: float = MERGE_M) -> dict:
+    """⭐ ②-1c R4: the SAME denominator, derived from the FACTS LAYER.
+
+    F-130's shape was "the reading exam re-runs the converter while the
+    correction answer is frozen on disk -- change the converter and only one
+    ruler moves".  This entry point ends that: both rulers derive from the
+    same on-disk ``as_measured``/``as_signed`` document, so they freeze and
+    move together.
+
+    It feeds :func:`_d1_d5_core` -- ⛔ NOT a re-implementation of D1-D5 --
+    with segments rebuilt from the facts layer's own 0.1 mm integers.
+    MEASURED equivalence to the DXF path (acceptance #6, real sm25, both
+    views): ``targets`` / ``allowed_not_required`` / ``opening_targets`` are
+    equal ELEMENT BY ELEMENT (as sets of tuples; the two paths iterate
+    strokes in different orders, so LIST order differs -- the grade consumes
+    them order-insensitively and the grade output is bit-identical), and the
+    ledger's count lines agree exactly.
+
+    Two fields are honestly THINNER than the DXF path, because the facts
+    layer never stored them: ``excluded_non_orthogonal_segments[].p0_dxf /
+    p1_dxf`` (native-DXF endpoints -- only the world-metre copies ride on
+    the facts layer).  The grade never reads them; they are omitted rather
+    than fabricated.
+    """
+    r = view.converter_readouts
+    units = 10000.0   # UNITS_PER_METRE, inlined to avoid a circular import
+
+    segs = []
+    for f in view.face_lines:
+        den_axis = "y" if f.axis == "x" else "x"
+        const_m = f.const / units
+        segs.append((den_axis, round(const_m, QUANT),
+                     round(f.along_min / units, QUANT),
+                     round(f.along_max / units, QUANT), f.id))
+    opening_spans: dict[str, list[tuple[float, float, float, float]]] = {"x": [], "y": []}
+    for o in view.openings:
+        den_axis = "y" if o.axis == "x" else "x"
+        opening_spans[den_axis].append((round(o.cross_lo / units, QUANT),
+                                        round(o.cross_hi / units, QUANT),
+                                        round(o.along_min / units, QUANT),
+                                        round(o.along_max / units, QUANT)))
+    converter_cap_handles = {h for band in r.jamb_cap_bands
+                             for h in band.get("cap_handles", [])}
+    excluded_non_orthogonal = []
+    for s in r.non_orthogonal_lines:
+        p0 = (round(s.p0[0] / units, QUANT), round(s.p0[1] / units, QUANT))
+        p1 = (round(s.p1[0] / units, QUANT), round(s.p1[1] / units, QUANT))
+        excluded_non_orthogonal.append({
+            "handle": s.id,
+            "p0_m": [p0[0], p0[1]],
+            "p1_m": [p1[0], p1[1]],
+            "length_m": round(((p1[0] - p0[0]) ** 2 + (p1[1] - p0[1]) ** 2) ** 0.5,
+                              QUANT)})
+
+    faces = _d1_d5_core(segs, opening_spans, converter_cap_handles,
+                        excluded_non_orthogonal,
+                        t_max_m=max(float(t) for t in request.wall_thickness_range_m),
+                        merge_m=merge_m)
+    targets, allowed = faces["targets"], faces["allowed_not_required"]
+    counts = faces["counts"]
+
+    opening_targets = []
+    for o in view.openings:
+        den_axis = "y" if o.axis == "x" else "x"
+        lo, hi = round(o.along_min / units, QUANT), round(o.along_max / units, QUANT)
+        c_lo, c_hi = round(o.cross_lo / units, QUANT), round(o.cross_hi / units, QUANT)
+        opening_targets.append({"kind": o.kind, "axis": den_axis,
+                                "const_range_m": [c_lo, c_hi],
+                                "lo_m": lo, "hi_m": hi,
+                                "width_m": round(hi - lo, 4)})
+    diagnostics = [{**d, "locatable": bool(d.get("handles") or d.get("points_dxf_mm"))}
+                   for d in r.diagnostics]
+    gates = r.gates
+    result = {
+        "rule_version": "denominator_v1",
+        "view_id": view.view_id, "floor_id": view.floor_id,
+        "params": {"merge_m": merge_m, "coordinate_round_decimals": QUANT},
+        "ledger": {
+            "wall_layer_segments_collected": r.wall_lines_total,
+            "s4_dangles": r.dangles, "s4_cuts": r.cuts, "s4_invalid": r.invalid,
+            "excluded_jamb_caps_geometric": counts["excluded_jamb_caps_geometric"],
+            "would_be_excluded_by_converter_length_rule":
+                counts["would_be_excluded_by_converter_length_rule"],
+            "excluded_non_orthogonal": len(excluded_non_orthogonal),
+            "face_segments": counts["face_segments"],
+            "face_lines_after_grouping": counts["face_lines_after_grouping"],
+            "scoreable_targets_after_merge": len(targets),
+            "fragments_per_face_line": counts["fragments_per_face_line"],
+            "total_scoreable_length_m": round(sum(t["length_m"] for t in targets), 3),
+            "merges_blocked_by_an_opening": counts["merges_blocked_by_an_opening"],
+            "wall_landing_holes": counts["wall_landing_holes"],
+            "wall_landing_hole_length_m": counts["wall_landing_hole_length_m"],
+        },
+        "targets": targets,
+        "allowed_not_required": allowed,
+        "excluded_non_orthogonal_segments": excluded_non_orthogonal,
+        "opening_targets": opening_targets,
+        "opening_ledger": {"total": len(opening_targets),
+                           "by_kind": {k: sum(1 for o in opening_targets if o["kind"] == k)
+                                       for k in sorted({o["kind"] for o in opening_targets})}},
+        "diagnostics": diagnostics,
+        "gates": gates,
+    }
+    if not targets:
+        raise DenominatorUnavailable(
+            REASON_UPSTREAM_BLOCK if any(d["severity"] == "BLOCK" for d in diagnostics)
+            else REASON_ZERO_TARGETS,
+            view_id=view.view_id, floor_id=view.floor_id,
+            diagnostics=diagnostics, ledger=result["ledger"], gates=gates)
+    return result
+
+
 def denominator(dxf: Path, request_path: Path, view_id: str, *,
                 merge_m: float = MERGE_M) -> dict:
     request = TarchConversionRequestV1.model_validate_json(Path(request_path).read_text())
