!- Linux Line endings 

VERSION,
    25.1.0;                   !- Version Identifier

SIMULATIONCONTROL,
    No,                       !- Do Zone Sizing Calculation
    No,                       !- Do System Sizing Calculation
    No,                       !- Do Plant Sizing Calculation
    Yes,                      !- Run Simulation for Sizing Periods
    Yes,                      !- Run Simulation for Weather File Run Periods
    Yes,                      !- Do HVAC Sizing Simulation for Sizing Periods
    1;                        !- Maximum Number of HVAC Sizing Simulation Passes

BUILDING,
    sm21_anchor,              !- Name
    0,                        !- North Axis
    Suburbs,                  !- Terrain
    0.04,                     !- Loads Convergence Tolerance Value
    0.4,                      !- Temperature Convergence Tolerance Value
    FullExterior,             !- Solar Distribution
    25,                       !- Maximum Number of Warmup Days
    1;                        !- Minimum Number of Warmup Days

SITE:LOCATION,
    Shenzhen_CN,              !- Name
    22.543,                   !- Latitude
    114.058,                  !- Longitude
    8,                        !- Time Zone
    10;                       !- Elevation

RUNPERIOD,
    Default Run Period,       !- Name
    1,                        !- Begin Month
    1,                        !- Begin Day of Month
    ,                         !- Begin Year
    12,                       !- End Month
    31,                       !- End Day of Month
    ,                         !- End Year
    ,                         !- Day of Week for Start Day
    Yes,                      !- Use Weather File Holidays and Special Days
    Yes,                      !- Use Weather File Daylight Saving Period
    No,                       !- Apply Weekend Holiday Rule
    Yes,                      !- Use Weather File Rain Indicators
    Yes,                      !- Use Weather File Snow Indicators
    No,                       !- Treat Weather as Actual
    Hour24;                   !- First Hour Interpolation Starting Values

SCHEDULETYPELIMITS,
    Fraction,                 !- Name
    0,                        !- Lower Limit Value
    1,                        !- Upper Limit Value
    CONTINUOUS,               !- Numeric Type
    Dimensionless;            !- Unit Type

SCHEDULETYPELIMITS,
    Temperature,              !- Name
    -60,                      !- Lower Limit Value
    200,                      !- Upper Limit Value
    CONTINUOUS,               !- Numeric Type
    Temperature;              !- Unit Type

SCHEDULETYPELIMITS,
    OnOff,                    !- Name
    0,                        !- Lower Limit Value
    1,                        !- Upper Limit Value
    DISCRETE,                 !- Numeric Type
    Dimensionless;            !- Unit Type

SCHEDULETYPELIMITS,
    ActivityLevel,            !- Name
    0,                        !- Lower Limit Value
    1000,                     !- Upper Limit Value
    CONTINUOUS,               !- Numeric Type
    Dimensionless;            !- Unit Type

SCHEDULE:COMPACT,
    Heating_Setpoint,         !- Name
    Temperature,              !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00,             !- Field 3
    20.0;                     !- Field 4

SCHEDULE:COMPACT,
    Cooling_Setpoint,         !- Name
    Temperature,              !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00,             !- Field 3
    24.0;                     !- Field 4

SCHEDULE:COMPACT,
    People_Activity,          !- Name
    ActivityLevel,            !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00,             !- Field 3
    120.0;                    !- Field 4

SCHEDULE:COMPACT,
    HVAC_Availability,        !- Name
    OnOff,                    !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 24:00,             !- Field 3
    1.0;                      !- Field 4

SCHEDULE:COMPACT,
    People_Occupancy,         !- Name
    Fraction,                 !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: Weekdays,            !- Field 2
    Until: 09:00,             !- Field 3
    0.0,                      !- Field 4
    Until: 18:00,             !- Field 5
    1.0,                      !- Field 6
    Until: 24:00,             !- Field 7
    0.0,                      !- Field 8
    For: Weekends,            !- Field 9
    Until: 24:00,             !- Field 10
    0.0,                      !- Field 11
    For: Holidays,            !- Field 12
    Until: 24:00,             !- Field 13
    0.0,                      !- Field 14
    For: AllOtherDays,        !- Field 15
    Until: 24:00,             !- Field 16
    0.0;                      !- Field 17

SCHEDULE:COMPACT,
    Lights_Schedule,          !- Name
    Fraction,                 !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: Weekdays,            !- Field 2
    Until: 09:00,             !- Field 3
    0.0,                      !- Field 4
    Until: 18:00,             !- Field 5
    1.0,                      !- Field 6
    Until: 24:00,             !- Field 7
    0.0,                      !- Field 8
    For: Weekends,            !- Field 9
    Until: 24:00,             !- Field 10
    0.0,                      !- Field 11
    For: Holidays,            !- Field 12
    Until: 24:00,             !- Field 13
    0.0,                      !- Field 14
    For: AllOtherDays,        !- Field 15
    Until: 24:00,             !- Field 16
    0.0;                      !- Field 17

MATERIAL,
    Mat_Stucco,               !- Name
    MediumRough,              !- Roughness
    0.025,                    !- Thickness
    0.72,                     !- Conductivity
    1856,                     !- Density
    840,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Mat_Gypsum,               !- Name
    Smooth,                   !- Roughness
    0.0127,                   !- Thickness
    0.16,                     !- Conductivity
    900,                      !- Density
    900,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Mat_Floor_Concrete,       !- Name
    MediumRough,              !- Roughness
    0.15,                     !- Thickness
    1.95,                     !- Conductivity
    2240,                     !- Density
    900,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL,
    Mat_Roof_Membrane,        !- Name
    VeryRough,                !- Roughness
    0.0095,                   !- Thickness
    0.16,                     !- Conductivity
    1120,                     !- Density
    1460,                     !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

MATERIAL:NOMASS,
    Mat_Insulation,           !- Name
    Smooth,                   !- Roughness
    2.5,                      !- Thermal Resistance
    0.9,                      !- Thermal Absorptance
    0.7,                      !- Solar Absorptance
    0.7;                      !- Visible Absorptance

WINDOWMATERIAL:SIMPLEGLAZINGSYSTEM,
    Simple_Window_Glazing,    !- Name
    2.5,                      !- UFactor
    0.5,                      !- Solar Heat Gain Coefficient
    ;                         !- Visible Transmittance

CONSTRUCTION,
    Default_Ext_Wall,         !- Name
    Mat_Stucco,               !- Outside Layer
    Mat_Insulation,           !- Layer 2
    Mat_Gypsum;               !- Layer 3

CONSTRUCTION,
    Default_Int_Wall,         !- Name
    Mat_Gypsum,               !- Outside Layer
    Mat_Insulation,           !- Layer 2
    Mat_Gypsum;               !- Layer 3

CONSTRUCTION,
    Default_GroundFloor,      !- Name
    Mat_Floor_Concrete,       !- Outside Layer
    Mat_Insulation,           !- Layer 2
    Mat_Gypsum;               !- Layer 3

CONSTRUCTION,
    Default_Roof,             !- Name
    Mat_Roof_Membrane,        !- Outside Layer
    Mat_Insulation,           !- Layer 2
    Mat_Gypsum;               !- Layer 3

CONSTRUCTION,
    Cons_InterFloor,          !- Name
    Mat_Floor_Concrete;       !- Outside Layer

CONSTRUCTION,
    Default_Window,           !- Name
    Simple_Window_Glazing;    !- Outside Layer

GLOBALGEOMETRYRULES,
    UpperLeftCorner,          !- Starting Vertex Position
    Counterclockwise,         !- Vertex Entry Direction
    Relative,                 !- Coordinate System
    Relative,                 !- Daylighting Reference Point Coordinate System
    Relative;                 !- Rectangular Surface Coordinate System

