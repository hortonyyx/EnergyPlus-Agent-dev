+@dataclass(frozen=True)
+class _BoundaryOwner:
+    """One exact topological claim on a cavity span.
+
+    A face claim is the existing relation: the cavity span lies on one of a
+    parallel wall group's two faces.  An endcap claim is perpendicular: the
+    wall's two drawn faces terminate exactly on the two faces of an
+    intersecting wall band, while its transverse face interval overlaps the
+    span by positive length.  No coordinate is rounded and no near-enough
+    distance is admitted.  Requiring that exact T-junction is what keeps a
+    split ``52399``/``52401`` end from masquerading as a cap of the wall band
+    whose measured face is ``52400``.
+    """
+
+    kind: Literal["face", "endcap"]
+    group: _BoundaryWallGroup
+    wall: AsMeasuredWallV1 | None = None
+
+    @property
+    def key(self) -> tuple[object, ...]:
+        return (self.kind, self.group.key, self.wall.id if self.wall else "")
+
+    @property
+    def wall_ids(self) -> list[str]:
+        if self.wall is not None:
+            return [self.wall.id]
+        return self.group.wall_ids
+
+    @property
+    def face_line_handles(self) -> list[str]:
+        if self.wall is not None:
+            return sorted({*self.wall.face_line_ids_lo,
+                           *self.wall.face_line_ids_hi})
+        return self.group.face_line_handles
+
+    def handles(self, side: Literal["lo", "hi"]) -> list[str]:
+        if self.wall is None:
+            return self.group.handles(side)
+        return sorted(self.wall.face_line_ids_lo if side == "lo"
+                      else self.wall.face_line_ids_hi)
+
+
