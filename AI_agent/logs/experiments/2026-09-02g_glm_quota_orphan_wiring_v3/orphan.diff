+def _sentinel_config(tmp_path: Path, *, include_decision: bool = True) -> Path:
+    """An active llm.yaml whose two sections point at DIFFERENT models."""
+    lines = [
+        "intake_correction:",
+        "  provider: openai",
+        "  model_name: sentinel-intake-model",
+        "  api_key: literal-key",
+    ]
+    if include_decision:
+        lines += [
+            "correction_decision:",
+            "  provider: openai",
+            "  model_name: sentinel-decision-model",
+            "  api_key: literal-key",
+        ]
+    cfg = tmp_path / "llm.yaml"
+    cfg.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return cfg
+
